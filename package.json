{
	"name": "lceda-extension-doctor",
	"version": "0.3.1",
	"private": true,
	"description": "嘉立创 EDA / EasyEDA Pro 扩展诊断与精确卸载维护工具",
	"author": "GPTKEY",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"compile": "rimraf ./dist/ && ts-node ./config/esbuild.prod.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.mjs",
		"check:iframe": "node --check iframe/confirm-bridge.js && node --check iframe/doctor.js",
		"build": "npm run compile && ts-node ./build/packaged.ts",
		"verify": "npm run test && npm run check:iframe && npm run typecheck && npm run build"
	},
	"devDependencies": {
		"@jlceda/pro-api-types": "^0.2.21",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^22.10.0",
		"@types/react": "^19.1.9",
		"esbuild": "^0.24.2",
		"fs-extra": "^11.3.0",
		"ignore": "^7.0.3",
		"jszip": "^3.10.1",
		"rimraf": "^6.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3"
	}
}
